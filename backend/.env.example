# ---------- Core ----------
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
DATABASE_URL=postgresql://chakritrack:local-development-only@localhost:5545/chakritrack
# Leave empty to run without BullMQ (jobs then run in-process; dev only)
REDIS_URL=redis://localhost:6389
RUN_WORKER=true

# ---------- Auth ----------
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-random-secret-of-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=60
GOOGLE_OAUTH_CLIENT_IDS=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ---------- Encryption (document vault + portal credentials) ----------
# 32-byte base64 key-encryption key. Production: keep in a KMS / secret manager, never in git.
VAULT_KEK_BASE64=
FIELD_ENCRYPTION_KEY_BASE64=

# ---------- Storage (S3 / Cloudflare R2 / MinIO) ----------
STORAGE_DRIVER=s3
S3_BUCKET=chakritrack-private
S3_REGION=auto
S3_ENDPOINT=http://localhost:9010
S3_ACCESS_KEY_ID=chakritrack
S3_SECRET_ACCESS_KEY=local-development-only
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300
MAX_UPLOAD_MB=10

# ---------- AI (provider-agnostic gateway) ----------
AI_PROVIDER=gemini            # gemini | openai | openai_compatible | mock
AI_API_KEY=
AI_MODEL_VISION=              # model id for circular image/PDF extraction (verify current model names)
AI_MODEL_TEXT=                # cheaper model for CV score / viva / explanations
AI_MONTHLY_BUDGET_USD=50      # hard stop across all users; per-user quotas in Project_spec §9
OCR_FALLBACK=tesseract        # tesseract (ben+eng) | none

# ---------- Notifications ----------
PUSH_DRIVER=console           # console | expo | fcm
EXPO_ACCESS_TOKEN=
FCM_SERVICE_ACCOUNT_BASE64=
WEB_PUSH_VAPID_PUBLIC=
WEB_PUSH_VAPID_PRIVATE=
WEB_PUSH_SUBJECT=mailto:support@example.com
EMAIL_DRIVER=console          # console | smtp | resend
SMTP_URL=
EMAIL_FROM="ChakriTrack <no-reply@example.com>"
SMS_DRIVER=console            # console | http (BTRC-enlisted aggregator; see docs/research)
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_MONTHLY_BUDGET_BDT=2000

# ---------- Payments ----------
PAYMENT_MODE=sandbox
BKASH_BASE_URL=               # shared by bKash during onboarding (sandbox is public)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_CALLBACK_URL=http://localhost:4000/api/v1/billing/bkash/callback

# ---------- Product knobs ----------
FREE_ACTIVE_APPLICATIONS_LIMIT=30
FREE_AI_EXTRACTIONS_PER_MONTH=10
FREE_STORAGE_MB=100
DEFAULT_REMINDER_OFFSETS_MIN=-10080,-4320,-1440,-180
TZ_DEFAULT=Asia/Dhaka

# ---------- Observability ----------
SENTRY_DSN=
POSTHOG_KEY=
